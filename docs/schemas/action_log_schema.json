{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browserbot.local/schemas/action_log/v1.json",
  "title": "BrowserBot Action Log",
  "description": "Structured record of a single human-demonstrated browser workflow session. Produced by the Recorder (Phase 2) and consumed by the Pattern Extractor (Phase 3). Version 1 — frozen contract.",
  "type": "object",

  "required": ["schema_version", "metadata", "steps"],
  "additionalProperties": false,

  "properties": {

    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Action Log schema version. Increment the major digit on any breaking change. Downstream agents must reject logs whose schema_version they do not support."
    },

    "metadata": {
      "type": "object",
      "description": "Session-level metadata. Describes where and when the recording was made.",
      "required": ["session_id", "site", "recorded_at", "browserbot_version"],
      "additionalProperties": false,
      "properties": {

        "session_id": {
          "type": "string",
          "pattern": "^session_[0-9]{8}T[0-9]{6}$",
          "description": "Unique session identifier. Format: session_YYYYMMDDTHHMMSS. Generated by the Recorder at session start.",
          "examples": ["session_20260715T143022"]
        },

        "site": {
          "type": "string",
          "format": "hostname",
          "description": "Hostname of the target website (no protocol, no path). Used by the Pattern Extractor to scope selector patterns to a known site.",
          "examples": ["nobuycart.com", "example.com"]
        },

        "start_url": {
          "type": "string",
          "format": "uri",
          "description": "The URL the browser navigated to first in this session. Optional — present when a specific starting URL is known.",
          "examples": ["https://nobuycart.com/tracking/"]
        },

        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of when the recording started.",
          "examples": ["2026-07-15T14:30:22Z"]
        },

        "browserbot_version": {
          "type": "string",
          "description": "Version of BrowserBot that produced this log. Enables schema compatibility checks in downstream agents.",
          "examples": ["0.1.0"]
        },

        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Total wall-clock duration of the recorded session in seconds. Set by the Recorder when the session ends.",
          "examples": [18.42]
        },

        "step_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of steps in this log. Must equal len(steps). Redundant but useful for a quick sanity-check without parsing the full array.",
          "examples": [7]
        },

        "workflow_hint": {
          "type": "string",
          "description": "Optional free-text description of the workflow being recorded. Written by the user or inferred by the Recorder. Helps the Pattern Extractor name the generated workflow.",
          "examples": ["Order status lookup on NoBuyCart"]
        }
      }
    },

    "steps": {
      "type": "array",
      "description": "Ordered list of browser actions captured during the recording session. Each step is a discriminated union keyed on 'action'.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Step"
      }
    }
  },

  "$defs": {

    "Step": {
      "description": "A single browser action. The 'action' field discriminates between action types. Each type enforces its own required fields.",
      "oneOf": [
        { "$ref": "#/$defs/GotoStep" },
        { "$ref": "#/$defs/FillStep" },
        { "$ref": "#/$defs/ClickStep" },
        { "$ref": "#/$defs/SelectStep" },
        { "$ref": "#/$defs/CheckStep" },
        { "$ref": "#/$defs/HoverStep" },
        { "$ref": "#/$defs/WaitStep" },
        { "$ref": "#/$defs/ExtractTextStep" },
        { "$ref": "#/$defs/ExtractAttributeStep" },
        { "$ref": "#/$defs/ScrollStep" },
        { "$ref": "#/$defs/PressKeyStep" },
        { "$ref": "#/$defs/ScreenshotStep" }
      ]
    },

    "BaseStep": {
      "type": "object",
      "description": "Fields common to every action step.",
      "required": ["step_index", "action", "timestamp_offset"],
      "properties": {

        "step_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based position of this step in the steps array. Must equal its index in the array."
        },

        "action": {
          "type": "string",
          "description": "Action type discriminator."
        },

        "timestamp_offset": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds elapsed since session start when this action was recorded. Used by the Validator for timing-based replay fidelity checks."
        },

        "frame_url": {
          "type": "string",
          "format": "uri",
          "description": "URL of the browser frame in which the action occurred. Usually the top-level page URL, but may differ for iframes."
        },

        "page_title": {
          "type": "string",
          "description": "Title of the page at the time the action was recorded."
        }
      }
    },

    "SelectorInfo": {
      "type": "object",
      "description": "Selector used to locate the target element. Records both the selector string and the locator strategy so Phase 8 can apply selector-robustness improvements.",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {

        "value": {
          "type": "string",
          "description": "The selector string as passed to Playwright.",
          "examples": ["#order-id", "button[type=submit]", ".order-status", "text=Track"]
        },

        "strategy": {
          "type": "string",
          "enum": ["css", "xpath", "text", "role", "label", "placeholder", "test_id", "nth", "other"],
          "description": "Selector strategy used. 'css' for CSS selectors, 'role' for ARIA-role locators, etc. Defaults to 'css' when absent.",
          "default": "css"
        },

        "aria_role": {
          "type": "string",
          "description": "ARIA role of the target element when strategy is 'role'.",
          "examples": ["button", "textbox", "link", "heading"]
        },

        "aria_name": {
          "type": "string",
          "description": "Accessible name filter when strategy is 'role'.",
          "examples": ["Track", "Submit", "Order ID"]
        }
      }
    },

    "GotoStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "goto" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "URL navigated to."
            },
            "wait_until": {
              "type": "string",
              "enum": ["load", "domcontentloaded", "networkidle", "commit"],
              "default": "load",
              "description": "Playwright wait_until strategy used for this navigation."
            }
          }
        }
      ]
    },

    "FillStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector", "value"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "fill" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "value": {
              "type": "string",
              "description": "Text typed into the field. Password-type fields are replaced with a scrubbed placeholder at capture time (Step 2.4). The original value is NEVER stored.",
              "examples": ["NBC-2026-8F3K2Q", "__SECRET_1__"]
            },
            "is_sensitive": {
              "type": "boolean",
              "default": false,
              "description": "True when the field is type=password or was explicitly flagged as sensitive. When true, 'value' MUST be a scrubbed placeholder, never the raw text."
            },
            "field_label": {
              "type": "string",
              "description": "Accessible label of the field, if determinable. Used by Pattern Extractor to name the parameter.",
              "examples": ["Fake order code", "Order ID", "Username"]
            }
          }
        }
      ]
    },

    "ClickStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "click" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "button": {
              "type": "string",
              "enum": ["left", "right", "middle"],
              "default": "left",
              "description": "Mouse button used."
            },
            "click_count": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Number of clicks (1 = single, 2 = double)."
            }
          }
        }
      ]
    },

    "SelectStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector", "option_value"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "select" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "option_value": {
              "type": "string",
              "description": "The value attribute of the selected <option> element."
            },
            "option_label": {
              "type": "string",
              "description": "Visible text of the selected option (for readability)."
            }
          }
        }
      ]
    },

    "CheckStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector", "checked"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "check" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "checked": {
              "type": "boolean",
              "description": "True = check the checkbox; False = uncheck."
            }
          }
        }
      ]
    },

    "HoverStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "hover" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" }
          }
        }
      ]
    },

    "WaitStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["wait_for"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "wait" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "wait_for": {
              "type": "string",
              "enum": ["selector", "navigation", "network_idle", "timeout"],
              "description": "What the wait is blocking on."
            },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "timeout_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Milliseconds to wait (for wait_for=timeout or as a maximum for other wait types)."
            },
            "state": {
              "type": "string",
              "enum": ["attached", "detached", "visible", "hidden"],
              "description": "Expected element state (for wait_for=selector)."
            }
          }
        }
      ]
    },

    "ExtractTextStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector", "extracted_text"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "extract_text" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "extracted_text": {
              "type": "string",
              "description": "The text content that was read from the element. Stored in the log so the Validator can compare replay output against the ground truth without re-running the page."
            },
            "output_variable": {
              "type": "string",
              "description": "Name to assign the extracted value in the generated script's return dict.",
              "examples": ["order_status", "shipment_carrier", "expected_delivery"]
            }
          }
        }
      ]
    },

    "ExtractAttributeStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["selector", "attribute", "extracted_value"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "extract_attribute" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "attribute": {
              "type": "string",
              "description": "HTML attribute name to read.",
              "examples": ["href", "src", "data-status", "value"]
            },
            "extracted_value": {
              "type": ["string", "null"],
              "description": "The attribute value captured at recording time."
            },
            "output_variable": {
              "type": "string",
              "description": "Name for this value in the generated script's return dict."
            }
          }
        }
      ]
    },

    "ScrollStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "scroll" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "delta_x": {
              "type": "integer",
              "description": "Horizontal scroll distance in pixels. Negative = left."
            },
            "delta_y": {
              "type": "integer",
              "description": "Vertical scroll distance in pixels. Negative = up."
            }
          }
        }
      ]
    },

    "PressKeyStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "press_key" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "selector":          { "$ref": "#/$defs/SelectorInfo" },
            "key": {
              "type": "string",
              "description": "Key name in Playwright key syntax.",
              "examples": ["Enter", "Tab", "Escape", "ArrowDown"]
            }
          }
        }
      ]
    },

    "ScreenshotStep": {
      "allOf": [
        { "$ref": "#/$defs/BaseStep" },
        {
          "type": "object",
          "required": ["filename"],
          "additionalProperties": false,
          "properties": {
            "step_index":        { "$ref": "#/$defs/BaseStep/properties/step_index" },
            "action":            { "type": "string", "const": "screenshot" },
            "timestamp_offset":  { "$ref": "#/$defs/BaseStep/properties/timestamp_offset" },
            "frame_url":         { "$ref": "#/$defs/BaseStep/properties/frame_url" },
            "page_title":        { "$ref": "#/$defs/BaseStep/properties/page_title" },
            "filename": {
              "type": "string",
              "description": "Relative path of the saved screenshot file within the session directory.",
              "examples": ["screenshots/step_006.png"]
            }
          }
        }
      ]
    }
  }
}
