    D1[(recording.json)]
    D2[(actions.json)]
    D3[(workflow_schema.json)]
    D4[(confirmed_schema.json)]
    D5[(playwright_script.py)]
    D6[(validation_report.json)]
    D7[(mcp_server/)]
