    P1([1. Record Workflow])
    P2([2. Normalize Actions])
    P3([3. Extract Workflow Pattern])
    P4([4. Confirm Parameters])
    P5([5. Generate Playwright Tool])
    P6([6. Validate Generated Tool])
    P7([7. Generate MCP Package])
    P8([8. Runtime Execution])

